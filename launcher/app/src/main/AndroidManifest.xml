<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Android 10 only reveals the Wi-Fi name (SSID) to apps holding location permission, and turning
         location on here pops Google's consent dialog. Instead DUMP (granted via `adb shell pm grant`) lets
         the launcher read the name from `dumpsys wifi`. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.DUMP" />
    <!-- lets the launcher re-enable its Home-button accessibility service (granted via `adb shell pm grant`) -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- KeyService watches the system log for the remote's Home/PatchWall presses (granted via `adb shell pm grant`) -->
    <uses-permission android:name="android.permission.READ_LOGS" />
    <!-- "Recently used" shelf (granted via `adb shell appops set ... GET_USAGE_STATS allow`) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <!-- install APKs received via Drop/LocalSend or found in Files (Android still shows its confirm screen) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- voice search (granted via `adb shell pm grant`) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- app switcher: "close app" (only ever hits background apps, the launcher is in front then) -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- routines: switch the screen on at the scheduled time -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- share receiver (LocalSend discovery + Drop) and the Files panel; storage granted via `adb shell pm grant` -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:label="Arsh TV"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:theme="@style/Home"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:hardwareAccelerated="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- The Xiaomi remote's Home button arrives as KEYCODE_ALL_APPS; Android TV turns it into an
                 ALL_APPS intent aimed at the system home package. With Settings' FallbackHome disabled
                 that intent becomes implicit and lands here. -->
            <intent-filter>
                <action android:name="android.intent.action.ALL_APPS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DropActivity"
            android:exported="false"
            android:theme="@style/Sheet"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:taskAffinity="com.arshanwar.tv_launcher.drop" />

        <activity
            android:name=".PinGateActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:taskAffinity="com.arshanwar.tv_launcher.gate" />




        <activity
            android:name=".FilesActivity"
            android:exported="false"
            android:excludeFromRecents="true" />

        <provider
            android:name=".FileProvider"
            android:authorities="com.arshanwar.tv_launcher.files"
            android:exported="false"
            android:grantUriPermissions="true" />

        <activity
            android:name=".LockActivity"
            android:exported="true"
            android:excludeFromRecents="true" />

        <receiver android:name=".RoutineReceiver" android:exported="false" />
        <activity
            android:name=".McpPairActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:taskAffinity="com.arshanwar.tv_launcher.pair" />
        <activity
            android:name=".RoutineActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:taskAffinity="com.arshanwar.tv_launcher.routine" />

        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".KeyService"
            android:exported="true"
            android:label="Home button"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/key_service" />
        </service>

        <service
            android:name=".LockDream"
            android:exported="true"
            android:label="Lock Screen"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>
</manifest>
